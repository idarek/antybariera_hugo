[ {{- $i := 0 -}}
   {{- range .Site.RegularPages  -}}
      {{- if not .Params.noSearch -}}
         {{- if gt $i 0 }},{{ end -}}
         {"date": {{ .Date.Unix | jsonify | safeJS }}, {{ if not (.Date.Equal .Lastmod) }}"lastmod": {{ .Lastmod.Unix | jsonify | safeJS }},{{ end }} "url": {{ .Permalink | jsonify | safeJS }}, "title":{{ .Title | jsonify  }}, "summary":{{ with .Description}}{{ . | plainify | jsonify | safeJS }}{{ else }}{{ .Summary | plainify | jsonify | safeJS }}{{ end }}, "content":{{ .Content | plainify | jsonify | safeJS }},"tags":[ {{- $t := 0 }}{{- range .Param "tags" -}}{{ if gt $t 0 }},{{ end }}{{ . | jsonify | safeJS }}{{ $t = add $t 1 }}{{ end -}} ] }
         {{- $i = add $i 1 -}}
      {{- end -}}
   {{- end -}} ]